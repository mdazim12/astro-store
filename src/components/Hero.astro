---
// --- 1. FETCH DYNAMIC CONTENT FROM WORDPRESS ---
// This component fetches its own data.

// Your working GraphQL query
const HERO_QUERY = `
  query GetTestHomePageHero {
    page(id: "/test-home/", idType: URI) {
      heroSection {
        heroTitle
        heroDescription
        heroButton
        heroButtonLink
        heroBackgroundImages {
          node {
            sourceUrl
            altText
          }
        }
      }
    }
  }
`;

// Your WordPress URL (update this to your real URL)
const API_URL = "https://store.insectsexpert.com/graphql";

let heroData;
let imageUrl, imageAlt;

try {
  const response = await fetch(API_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query: HERO_QUERY })
  });
  const json = await response.json();
  
  heroData = json.data.page.heroSection;
  imageUrl = heroData.heroBackgroundImages?.node?.sourceUrl;
  imageAlt = heroData.heroBackgroundImages?.node?.altText;

} catch (error) {
  console.error("Error fetching hero data:", error);
  // Set default data so the page doesn't crash
  heroData = {
    heroTitle: "Error Loading Content",
    heroDescription: "Could not connect to the CMS.",
    heroButton: "Try Again",
    heroButtonLink: "/"
  };
  imageUrl = "https://placehold.co/600x600/f0f0f0/ccc?text=Error";
  imageAlt = "Error loading image";
}
---

<!-- --- 2. THE RESPONSIVE HTML & TAILWIND --- --><section class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
    
    <!-- Left Column (Text Content) --><div class="text-center md:text-left">
      <!-- Hard-coded greeting --><span class="text-xl font-medium text-red-600">
        Hello, I'm
      </span>
      
      <!-- Dynamic Title from WordPress --><h1 class="text-5xl md:text-7xl font-bold text-gray-900 my-4">
        {heroData.heroTitle}
      </h1>
      
      <!-- Hard-coded subtitle --><p class="text-xl md:text-2xl text-gray-700">
        A <span class="text-green-600">Creative Designer</span> From 
        <span class="text-blue-600">New York</span>
      </p>

      <!-- Dynamic Description from WordPress --><p class="text-gray-600 my-6 leading-relaxed">
        {heroData.heroDescription}
      </p>

      <!-- Dynamic Button from WordPress --><a
        href={heroData.heroButtonLink}
        class="inline-block bg-red-600 text-white font-bold text-lg px-10 py-4 rounded-full shadow-lg hover:bg-red-700 transition-all duration-300"
      >
        {heroData.heroButton}
      </a>

      <!-- Hard-coded social links --><div class="flex justify-center md:justify-start gap-4 mt-8 text-2xl text-gray-700">
        <a href="#" class="hover:text-red-600">F</a>
        <a href="#" class="hover:text-red-600">T</a>
        <a href="#" class="hover:text-red-600">L</a>
        <a href="#" class="hover:text-red-600">B</a>
      </div>
    </div>

    <!-- Right Column (Image) --><!-- 'relative' allows us to position the floating icons --><div class="relative flex justify-center">
      <!-- Image container with the brush-stroke effect --><div class="relative w-[400px] h-[500px] md:w-[500px] md:h-[600px]">
        <img
          src={imageUrl}
          alt={imageAlt}
          class="w-full h-full object-cover"
          style="clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%);"
        />

        <!-- Floating Icons (Hard-coded) --><div class="absolute -top-4 left-4 md:top-10 md:left-10 bg-white p-4 rounded-lg shadow-xl animate-bounce-slow">
          <img src="https://i.ibb.co.com/SwRpcm0X/React-icon-svg.png" alt="Ai" class="rounded w-12" />
        </div>
        <div class="absolute top-10 right-4 md:top-20 md:right-10 bg-white p-4 rounded-lg shadow-xl animate-bounce-slow" style="animation-delay: 0.5s;">
          <img src="https://i.ibb.co.com/7dj9FfSN/icons8-wordpress.png" alt="Ps" class="rounded w-12" />
        </div>
        <div class="absolute bottom-10 left-1/2 -translate-x-1/2 bg-white p-4 rounded-lg shadow-xl animate-bounce-slow" style="animation-delay: 1s;">
          <img src="https://i.ibb.co.com/bR3Pr8Hh/nodejs-logo.png" alt="Figma" class="rounded w-12" />
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Simple animation for the floating icons --><style>
  @keyframes bounce-slow {
    0%, 100% {
      transform: translateY(-5%);
    }
    50% {
      transform: translateY(0);
    }
  }
  .animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
  }
</style>

