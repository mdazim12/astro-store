---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// This 'title' prop will be passed from your pages (like index.astro)
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <!-- Add any other head tags here -->
  </head>
  <body class="flex flex-col min-h-screen bg-white">
    <!-- 
      Navbar is placed here, outside the main content.
      We pass the 'title' prop to it so it can highlight the active link.
    -->
    <Navbar currentPage={title} />

    <!-- 
      This is your main page content. 
      'flex-1' makes it grow to fill all available space,
      pushing the footer down.
    -->
    <main class="flex-1">
      <slot /> <!-- Your page content from index.astro, etc., goes here -->
    </main>

    <!-- Footer is placed here, at the end of the body -->
    <Footer />
  </body>
</html>
